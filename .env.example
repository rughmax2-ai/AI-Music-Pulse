# Copy to .env for local runs. Never commit real secrets.

# Supabase (daily post sync + optional HE migration apply)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Discord fetcher (optional — workflow no-ops when unset)
DISCORD_BOT_TOKEN=
# Comma-separated channel snowflakes, e.g. 123,456
DISCORD_CHANNEL_IDS=
